# העתיקו לקובץ .env ומלאו. לעולם אל תעלו את הקובץ הזה למאגר קוד.

# פורט פנימי של השרת. מאחורי Caddy או nginx עם HTTPS.
PORT=3000

# תיקיית הנתונים (מסד נתונים, מפתח הצפנה). חייבת להיות בנפח קבוע ומגובה.
DATA_DIR=./data

# מפתח הצפנת נתונים במנוחה (AES-256-GCM), 32 בתים בקידוד base64.
# יצירה:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# חובה בייצור. אם הוא אובד, אי אפשר לשחזר את הנתונים. שמרו עותק במקום נפרד.
DATA_KEY=

# קבוצה: production / development
NODE_ENV=production

# כתובת האתר כפי שמשתמשים רואים (לעוגיות מאובטחות). למשל https://app.example.org
PUBLIC_URL=

# אזור זמן לחישוב שעות שקטות, שבת וחגים
TZ=Asia/Jerusalem

# --- שליחת הודעות SMS ---
# mock: לא שולח בפועל, רושם ל-outbox (לבדיקות והדרכה). http: ספק עם ממשק HTTP כללי.
SMS_PROVIDER=mock
# עבור SMS_PROVIDER=http:
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=
# תבנית גוף הבקשה (JSON). המשתנים {to} {text} {sender} יוחלפו (עם הימלטות JSON).
SMS_HTTP_BODY={"to":"{to}","text":"{text}","sender":"{sender}"}
# סוד לקבלת תשובות נכנסות מהספק (POST /api/sms/inbound?secret=...)
SMS_INBOUND_SECRET=

# --- עוזר הבינה המלאכותית בתוך האפליקציה ---
# mock: תשובת הדגמה בלבד. anthropic: קריאה אל Anthropic API, בטקסט מנוקה מפרטים מזהים בלבד.
AI_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=1800
